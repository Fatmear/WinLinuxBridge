# ---- local state and machine identity -------------------------------------
# Never commit anything that identifies a host or a user.
*.token
agent.token
credentials.dat
bridge.conf
.env
*.env

# ---- runtime artefacts ---------------------------------------------------
# The portable Python runtime and the vendored plink binary are produced by
# tools/build-runtime.ps1 and shipped inside the release archive, not in git.
win/runtime/
win/vendor/*.exe
win/vendor/*.dll

# ---- build / cache -------------------------------------------------------
__pycache__/
*.py[cod]
*.pyo
.mypy_cache/
.pytest_cache/
*.egg-info/
dist/
build/

# ---- editors / OS --------------------------------------------------------
.vscode/
.idea/
*.swp
Thumbs.db
Desktop.ini
.DS_Store

# ---- release output ------------------------------------------------------
release/
*.zip
